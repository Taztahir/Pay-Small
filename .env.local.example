# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PaySmall REST API  — points to the backend server
# The /api/v1 prefix is already baked in; just set the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Nomba API  — https://developer.nomba.com
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_API_KEY=your-nomba-api-key
NOMBA_SECRET_KEY=your-nomba-secret-key
NOMBA_WEBHOOK_URL=https://yourdomain.com/api/webhooks/nomba
